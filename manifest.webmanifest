{
  "name": "小工具 by ddxu2",
  "short_name": "小工具",
  "start_url": "/?from=a2hs",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "/pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/_share-target/chinese-card",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "image",
          "accept": ["image/*"]
        },
        {
          "name": "file",
          "accept": [".ccpack", ".zip", "application/octet-stream", "application/zip"]
        }
      ]
    }
  }
}
